<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register - Hot Potato</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>
  
  <main class="container flex" style="align-items: center; justify-content: center; min-height: calc(100vh - 100px);">
    <div class="glass-panel" style="width: 100%; max-width: 400px;">
      <h2 class="text-center mb-3">Register Student</h2>
      <%- include('../partials/flash') %>
      
      <form action="/register" method="POST">
        <input type="hidden" name="batchId" value="<%= batchId %>">
        <div class="form-group">
          <label>Full Name</label>
          <input type="text" name="name" class="form-control" required placeholder="John Doe">
        </div>
        <div class="form-group">
          <label>Email Address</label>
          <input type="email" name="email" class="form-control" required placeholder="john@college.edu">
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" name="password" class="form-control" required placeholder="••••••••">
        </div>
        <button type="submit" class="btn btn-primary w-full mt-2">Join Batch</button>
      </form>
      
      <div class="mt-4 text-center">
        <a href="/login" class="text-muted" style="font-size: 0.9em;">Already have an account? Log in</a>
      </div>
    </div>
  </main>
</body>
</html>
