<header class="site-header">
  <div class="brand">
    <a href="/" style="color: white; display: flex; align-items: center; gap: 10px;">
      <span>🥔</span> Hot Potato
    </a>
  </div>

  <nav>
    <% if (locals.user) { %>
      <% if (locals.user.role === 'admin') { %>
        <a href="/admin">Dashboard</a>
      <% } %>
      <div class="profile-dropdown">
        <button class="btn btn-small profile-btn" id="profileBtn" onclick="document.getElementById('profileMenu').classList.toggle('show');">
          <%= user.name.charAt(0).toUpperCase() %>
        </button>
        <div id="profileMenu" class="profile-menu">
          <div class="profile-menu-header">
            <strong><%= user.name %></strong>
            <div class="profile-menu-email"><%= user.email %></div>
          </div>
          <a href="/profile" class="profile-menu-link">My Profile</a>
          <form action="/logout" method="GET" class="profile-menu-form">
            <button type="submit" class="profile-menu-logout">Logout</button>
          </form>
        </div>
      </div>
      <script>
        // Close dropdown if clicked outside
        document.addEventListener('click', function(event) {
          const menu = document.getElementById('profileMenu');
          const btn = document.getElementById('profileBtn');
          if (menu.classList.contains('show') && !menu.contains(event.target) && !btn.contains(event.target)) {
            menu.classList.remove('show');
          }
        });
      </script>

    <% } else { %>
      <a href="/login" class="btn" style="background: rgba(255,255,255,0.1); color: white;">Login</a>
    <% } %>
  </nav>
</header>