<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password - Hot Potato</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>
  
  <main class="container flex" style="align-items: center; justify-content: center; min-height: calc(100vh - 100px);">
    <div class="glass-panel" style="width: 100%; max-width: 400px;">
      <h2 class="text-center mb-3">Reset Password</h2>
      <%- include('../partials/flash') %>
      
      <p class="text-muted text-center mb-4" style="font-size: 0.9em;">Enter your email and we'll send you a link to reset your password.</p>
      
      <form action="/forgot-password" method="POST">
        <div class="form-group">
          <label>Email Address</label>
          <input type="email" name="email" class="form-control" required placeholder="student@college.edu">
        </div>
        <button type="submit" class="btn btn-primary w-full mt-2">Send Reset Link</button>
      </form>
      
      <div class="mt-4 text-center">
        <a href="/login" class="text-muted" style="font-size: 0.9em;">Back to Login</a>
      </div>
    </div>
  </main>
</body>
</html>
